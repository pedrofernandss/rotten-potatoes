%p{style: "color: green"}= notice

- content_for :title, "Movies"

%h1 Movies

%h2 Search TMDb for a movie

= form_with url: search_tmdb_path, method: :get do |form|
  = form.label :search_terms, "Search Terms"
  = form.text_field :search_terms
  = form.submit "Search TMDb"

%table
  %thead
    %tr
      %th= link_to "Movie Title", movies_path(:sort_by => "title"), id: :title_header
      %th Rating
      %th Description
      %th= link_to "Release Date", movies_path(:sort_by => "release_date"), id: :release_date_header
      %th
  %tbody{id: "movies"}
    - @movies.each do |movie|
      %tr{id: dom_id(movie)}
        %td= movie.title
        %td= movie.rating
        %td= movie.description
        %td= movie.release_date
        %td= link_to "Show movie", movie

= link_to "New movie", new_movie_path