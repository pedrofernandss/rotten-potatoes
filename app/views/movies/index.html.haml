%p{style: "color: green"}= notice

- content_for :title, "Movies"

%h1 Movies

%table
  %thead
    %tr
      %th= link_to "Título", movies_path(:sort_by => "title"), id: :title_header
      %th Classificação
      %th Descrição
      %th= link_to "Data de lançamento", movies_path(:sort_by => "release_date"), id: :release_date_header
      %th
  %tbody{id: "movies"}
    - @movies.each do |movie|
      %tr{id: dom_id(movie)}
        %td= movie.title
        %td= movie.rating
        %td= movie.description
        %td= movie.release_date
        %td= link_to "Ver filme", movie

= link_to "New movie", new_movie_path